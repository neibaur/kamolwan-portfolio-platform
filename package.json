{
  "name": "hugo-blox-academic-cv-starter",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "Academic CV starter template for Hugo Blox with Tailwind CSS v4",
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||''; if(!ua.startsWith('pnpm/')) { console.error('Use pnpm to install dependencies.'); process.exit(1); }\"",
    "dev": "hugo server --disableFastRender",
    "build": "hugo --gc --minify",
    "pagefind": "pagefind --site public",
    "check:format": "prettier --check .",
    "format": "prettier --write .",
    "check:markdown": "markdownlint \"content/**/*.md\" README.md AGENTS.md --ignore \"content/**/_index.md\"",
    "validate": "pnpm check:format && pnpm check:markdown && pnpm build"
  },
  "dependencies": {
    "pagefind": "^1.5.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "4.3.2",
      "linkify-it": "5.0.2",
      "smol-toml@^1": "1.9.0",
      "source-map-js": "1.2.2",
      "postcss-selector-parser@6.0.10": "7.1.6",
      "katex@^0.16": "0.18.2",
      "@parcel/watcher@2.5.1": "2.6.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
